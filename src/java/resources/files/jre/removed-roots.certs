# Root certificates removed from the JRE's lib/security/cacerts at staging, for JREs that do not
# remove them yet. Matched by SHA-256 fingerprint of the DER encoding, not by alias.
# Opt out with JBP_CONFIG_JRE_REMOVED_ROOTS='{enabled: false}'.
Algorithm=SHA-256

